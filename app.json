{
  "expo": {
    "name": "challenge-ford-v1",
    "slug": "challenge-ford-v1",
    "version": "1.0.0",
    "scheme": "challenge-ford",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#003478"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fiap.challengeford",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#003478"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#003478"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac2540fd-3268-4ded-8557-5e5077c7012e"
      }
    }
  }
}
